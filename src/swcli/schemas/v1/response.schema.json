{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swcli.dev/schema/v1/response.schema.json",
  "title": "SWCLI Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "request_id", "success", "duration_ms"],
  "properties": {
    "api_version": {"const": "swcli/v1"},
    "request_id": {"type": "string", "minLength": 1},
    "success": {"type": "boolean"},
    "duration_ms": {"type": "number", "minimum": 0},
    "replayed": {
      "type": "boolean",
      "description": "True when swclid returned a cached response for request_id"
    },
    "result": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "details": {}
      }
    }
  }
}
