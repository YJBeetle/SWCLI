{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swcli.dev/schema/v1/capabilities.schema.json",
  "title": "SWCLI Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_versions",
    "server_version",
    "host",
    "operations",
    "operation_schemas",
    "worker_alive",
    "recovery_required",
    "recovery_error"
  ],
  "properties": {
    "protocol_versions": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "server_version": {"type": "string"},
    "host": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "solidworks_revision",
            "language",
            "process_id",
            "visible",
            "startup_wait_seconds",
            "owned_by_daemon",
            "shared_interactive",
            "platform"
          ],
          "properties": {
            "revision": {"type": "string"},
            "solidworks_revision": {"type": "string"},
            "language": {"type": "string"},
            "process_id": {"type": "integer", "minimum": 1},
            "visible": {"type": "boolean"},
            "startup_wait_seconds": {"type": "number", "minimum": 0},
            "owned_by_daemon": {"type": "boolean"},
            "shared_interactive": {"type": "boolean"},
            "platform": {"enum": ["windows", "macos-wine", "linux-wine"]}
          }
        },
        {"type": "null"}
      ]
    },
    "operations": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "operation_schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "$schema",
          "$id",
          "title",
          "type",
          "additionalProperties",
          "properties",
          "required",
          "x-swcli-context"
        ],
        "properties": {
          "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
          "$id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "type": {"const": "object"},
          "additionalProperties": {"const": false},
          "properties": {"type": "object"},
          "required": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "x-swcli-context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document_id", "expected_update_stamp", "lease_id"],
            "properties": {
              "document_id": {"enum": ["forbidden", "optional", "required"]},
              "expected_update_stamp": {"enum": ["forbidden", "optional", "required"]},
              "lease_id": {"enum": ["forbidden", "optional", "required"]}
            }
          }
        }
      }
    },
    "worker_alive": {"type": "boolean"},
    "recovery_required": {"type": "boolean"},
    "recovery_error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string"}
          }
        },
        {"type": "null"}
      ]
    }
  }
}
