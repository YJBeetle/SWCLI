{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swcli.dev/schema/v1/capabilities.schema.json",
  "title": "SWCLI Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_versions",
    "server_version",
    "host",
    "operations",
    "export_formats",
    "request_replay",
    "worker_alive",
    "host_connected",
    "recovery_required",
    "recovery_error"
  ],
  "dependentRequired": {
    "operation_schemas": ["operation_result_schemas"],
    "operation_result_schemas": ["operation_schemas"]
  },
  "properties": {
    "transport": {"type": "object", "additionalProperties": false, "properties": {"tls": {"type": "boolean"}, "authenticated": {"type": "boolean"}}, "required": ["tls", "authenticated"]},
    "workspace": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "properties": {"root": {"type": "string"}, "max_file_bytes": {"type": "integer", "minimum": 1}, "chunk_bytes": {"type": "integer", "minimum": 1}, "active_upload_limit": {"type": "integer", "minimum": 1}, "active_download_limit": {"type": "integer", "minimum": 1}, "expires_after_seconds": {"type": "integer", "minimum": 1}}, "required": ["root", "max_file_bytes", "chunk_bytes", "active_upload_limit", "active_download_limit", "expires_after_seconds"]}]},
    "export_formats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "assembly", "drawing"],
      "properties": {
        "part": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
        "assembly": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
        "drawing": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}}
      }
    },
    "protocol_versions": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "server_version": {"type": "string"},
    "host": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "solidworks_revision",
            "language",
            "process_id",
            "visible",
            "startup_wait_seconds",
            "owned_by_daemon",
            "shared_interactive",
            "platform"
          ],
          "properties": {
            "revision": {"type": "string"},
            "solidworks_revision": {"type": "string"},
            "language": {"type": "string"},
            "process_id": {"type": "integer", "minimum": 1},
            "visible": {"type": "boolean"},
            "startup_wait_seconds": {"type": "number", "minimum": 0},
            "owned_by_daemon": {"type": "boolean"},
            "shared_interactive": {"type": "boolean"},
            "platform": {"enum": ["windows", "macos-wine", "linux-wine"]}
          }
        },
        {"type": "null"}
      ]
    },
    "operations": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "operation_schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "$schema",
          "$id",
          "title",
          "type",
          "additionalProperties",
          "properties",
          "required",
          "x-swcli-context"
        ],
        "properties": {
          "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
          "$id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "type": {"const": "object"},
          "additionalProperties": {"const": false},
          "properties": {"type": "object"},
          "allOf": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "object"}
          },
          "required": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "x-swcli-font-write-profiles": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "notes"
            ],
            "properties": {
              "notes": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "runtime",
                  "solidworks_revision",
                  "document_types",
                  "fields",
                  "native_evidence_head",
                  "native_evidence_run",
                  "native_artifact_sha256"
                ],
                "properties": {
                  "runtime": {
                    "type": "string",
                    "const": "native-windows"
                  },
                  "solidworks_revision": {
                    "type": "string",
                    "const": "33.5.0"
                  },
                  "document_types": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "enum": [
                        1,
                        2,
                        3
                      ]
                    }
                  },
                  "fields": {
                    "type": "array",
                    "minItems": 7,
                    "maxItems": 7,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "typeface",
                        "height_mm",
                        "height_points",
                        "bold",
                        "italic",
                        "underline",
                        "strikeout"
                      ]
                    }
                  },
                  "native_evidence_head": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "native_evidence_run": {
                    "type": "string",
                    "pattern": "^https://github\\.com/YJBeetle/SWCLI/actions/runs/[0-9]+$"
                  },
                  "native_artifact_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "x-swcli-context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document_id", "expected_update_stamp", "lease_id"],
            "properties": {
              "document_id": {"enum": ["forbidden", "optional", "required"]},
              "expected_update_stamp": {"enum": ["forbidden", "optional", "required"]},
              "lease_id": {"enum": ["forbidden", "optional", "required"]}
            }
          }
        }
      }
    },
    "operation_result_schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["$schema", "$id", "type", "properties", "required", "additionalProperties"],
        "properties": {
          "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
          "$id": {"type": "string", "minLength": 1},
          "type": {"const": "object"},
          "properties": {"type": "object"},
          "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "additionalProperties": {"const": false}
        }
      }
    },
    "request_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "max_entries", "max_bytes", "scope"],
      "properties": {
        "supported": {"const": true},
        "max_entries": {"type": "integer", "minimum": 1},
        "max_bytes": {"type": "integer", "minimum": 1},
        "scope": {"const": "daemon"}
      }
    },
    "worker_alive": {"type": "boolean"},
    "host_connected": {"type": "boolean"},
    "recovery_required": {"type": "boolean"},
    "recovery_error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string"}
          }
        },
        {"type": "null"}
      ]
    }
  }
}
