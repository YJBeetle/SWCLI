{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swcli.dev/schema/v1/request.schema.json",
  "title": "SWCLI Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "request_id", "operation", "parameters"],
  "properties": {
    "api_version": {"const": "swcli/v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Scope for the daemon-side current document; omitted means default"
    },
    "document_id": {
      "description": "Short-lived document ID, or the one-shot active selector",
      "oneOf": [
        {"type": "string", "pattern": "^d-[0-9a-hjkmnp-tv-z]{6}$"},
        {"const": "active"}
      ]
    },
    "expected_update_stamp": {
      "type": "integer",
      "description": "Optional IModelDoc2::GetUpdateStamp precondition for the selected document"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^l-[0-9a-hjkmnp-tv-z]{12}$",
      "description": "Short-lived document lease token for guarded operations"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "description": "Operation advertised by the daemon capabilities payload"
    },
    "parameters": {
      "type": "object",
      "description": "Validated against capabilities.operation_schemas[operation]"
    },
    "timeout_ms": {"type": "integer", "minimum": 1}
  }
}
